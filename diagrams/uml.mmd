classDiagram
    class Owner {
        +String name
        +Pet pet
        +List~Task~ tasks
        +Dict~String,int~ constraints
        +createTask()
        +editTask()
    }

    class Pet {
        +String name
    }

    class Task {
        +String name
        +String description
        +int duration
        +int priority
        +String preferredTime
        +bool completionStatus
    }

    class Scheduler {
        +Owner owner
        +Dict~String,List~Task~~ plan
        +String explanationOfPlan
        +Dict~String,String~ skippedTasks
        +generateDailyPlan()
        +generateExplanationOfPlan()
    }

    Owner "1" --> "1" Pet : has
    Owner "1" --> "*" Task : has
    Scheduler "1" --> "1" Owner : reads from
