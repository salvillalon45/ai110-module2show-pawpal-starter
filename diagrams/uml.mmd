classDiagram
    class Owner {
        +String name
        +List~Pet~ pets 
        +Dict~String,int~ constraints
        +addPet()
        +getAllTasks()
    }

    class Task {
        +String name
        +String description
        +int duration
        +Priority priority
        +String preferredTime
        +Frequency frequency
        +bool completionStatus
        +String petName
        +Date dueDate
        +markComplete()
        +nextOccurrence()
    }

    class Priority {
        <<enumeration>>
        HIGH
        MEDIUM
        LOW
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +createTask()
        +editTask()
        +removeTask()
        +completeTask()
    }

    class Scheduler {
        +Owner owner
        +Dict~String,List~Task~~ plan
        +String explanationOfPlan
        +Dict~Tuple~String,String~,String~ skippedTasks
        +Dict~Tuple~String,String~,String~ placementReasons
        +generateDailyPlan()
        +generateExplanationOfPlan()
        +sortByTime()
        +filterTasks()
        +markTaskComplete()
    }

    Pet "1" --> "*" Task : has
    Task --> Priority
    Task --> Frequency
    Owner "1" --> "*" Pet : has
    Scheduler "1" --> "1" Owner : reads from
